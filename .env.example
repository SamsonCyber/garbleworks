# Copy to .env and fill only what you need. Never commit .env.

# Local generator (Ollama / OpenAI-compatible) for llm_* ops
# GARBLEWORKS_LLM_URL=http://127.0.0.1:11434/v1
# GARBLEWORKS_LLM_MODEL=qwen2.5:7b

# Engagement scope for MCP fire tools (default: local-selftest)
# GARBLEWORKS_SCOPE=local-selftest
# Comma-separated authorized hosts when using a custom scope receipt
# GARBLEWORKS_SCOPE_HOSTS=127.0.0.1,localhost

# Set to 1 to also block loopback + RFC-1918 on fire (strict mode)
# GARBLEWORKS_BLOCK_PRIVATE=0

# Optional path to field-guide.json (default: backend/data/field-guide.json)
# GARBLEWORKS_FIELDGUIDE=

# Optional Pliny / L1B3RT4S-style corpus root (liberation dumps stay local)
# If unset, Garbleworks also auto-detects corpora/L1B3RT4S or corpora/CL4R1T4S.
# GARBLEWORKS_PLINY_CORPUS=corpora/L1B3RT4S
# Then: python scripts/pliny_plug.py status

# Optional technique log DB path
# GARBLEWORKS_LOGDB=backend/data/technique_logs.db

# Optional API keys only if you run external judges / live bench scripts
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
