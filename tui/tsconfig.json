{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/probe_integration.ts",
    "src/run_live_probe.ts",
    "src/debug_spawn.ts",
    "src/apply_gw_smoke.ts"
  ]
}
